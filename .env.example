# Copia a .env y ajusta si es necesario. Todo tiene defaults razonables para uso local.

# Ruta al checkpoint del modelo High-Resolution Piano Transcription (~165 MB)
# Descárgalo con: python scripts/download_model.py
PIANO_CHECKPOINT_PATH=ml/checkpoints/note_F1=0.9677_pedal_F1=0.9186.pth

# Dispositivo de inferencia: auto | cuda | cpu   (auto usa CUDA si está disponible)
PIANO_DEVICE=auto

# Binario de FFmpeg (si no está en PATH, pon la ruta completa)
FFMPEG_BIN=ffmpeg

# Directorio de salida de transcripciones
PIANO_OUTPUT_DIR=data/output

# Backend FastAPI
API_HOST=127.0.0.1
API_PORT=8010

# Frontend: URL del backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010

# ---------------------------------------------------------------------------
# Nube (opcional): Supabase + Vercel. Ver docs/deploy.md
# ---------------------------------------------------------------------------
# En ESTA PC (worker y boton "Publicar"): URL del proyecto y clave secreta
# (sb_secret_... o la service_role JWT). La secreta NUNCA va al frontend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_ANON_KEY=sb_publishable_...

# En VERCEL (variables de entorno del proyecto):
#   NEXT_PUBLIC_SUPABASE_URL      = https://TU-PROYECTO.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY = sb_publishable_...
#   SUPABASE_SERVICE_ROLE_KEY     = sb_secret_...   (solo la usa /api/keepalive en el servidor)
#   CRON_SECRET                   = una cadena aleatoria larga
